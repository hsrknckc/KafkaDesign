<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ismail.kafkaconsumer.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="topic" promptText="Topic adını gir..."/>
    <Button text="Topic dinle" onAction="#previewMessages"/>
    <ComboBox fx:id="myComboBox"/>
    <Label fx:id="status" text="Durum: Kapalı"/>
    <TextArea fx:id="messageArea" editable="false"> </TextArea>
    <VBox fx:id="fileArea"> </VBox>
</VBox>
