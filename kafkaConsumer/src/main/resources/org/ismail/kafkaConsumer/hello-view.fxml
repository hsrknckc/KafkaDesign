<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="500.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ismail.kafkaConsumer.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <TextField fx:id="topic" promptText="Topic adını gir..." />
    <Button onAction="#previewMessages" text="Topic dinle" />
    <Label fx:id="status" text="Durum: Kapalı" />
   <ScrollPane fx:id="scrollPane" prefWidth="460.0">
      <content>
          <VBox fx:id="fileArea"> </VBox>
      </content>
   </ScrollPane>
</VBox>
