<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" prefHeight="513.0" prefWidth="900"
      style="-fx-background-color: linear-gradient(to bottom right, #7bb08c, #4a8061);"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.ismail.kafkaProducer.HelloController">
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
    <HBox spacing="20" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Sol kolon -->
        <VBox alignment="TOP_CENTER" prefWidth="300" spacing="20">

            <!-- Bölüm 1: String gönder -->
            <VBox alignment="CENTER" spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
                <Label styleClass="card-title" text="String gönder" />
                <TextField fx:id="topicName" promptText="Topic adını gir..." />
                <TextField fx:id="message" promptText="Mesajını gir..." />
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="sendString" styleClass="start-btn" text="Gönder" onAction="#sendString" />
                </HBox>
                <Label fx:id="status1"> </Label>
            </VBox>

            <!-- Bölüm 2: Dosya gönder -->
            <VBox alignment="CENTER" spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
                <Label styleClass="card-title" text="Dosya gönder" />
                <TextField fx:id="topicName2" promptText="Topic adını gir..." />
                <TextField fx:id="message2" promptText="Dosya yolunu gir..." />
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="previewFile" styleClass="start-btn" text="Önizleme" onAction="#previewFile" />
                    <Button fx:id="sendFile" styleClass="start-btn" text="Gönder" onAction="#sendFile" />
                </HBox>
                <Label fx:id="status2"> </Label>
            </VBox>

        </VBox>

        <!-- Sağ kolon: Önizleme -->
        <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" prefWidth="600">
            <Label styleClass="card-title" text="Dosya önizle" />
            <VBox fx:id="previewBox"> </VBox>
        </VBox>

    </HBox>

</VBox>
